package patina:host@0.1.0;

/// Structured logging for plugins
interface log {
    /// Log a message at the given level
    log: func(level: log-level, message: string);

    enum log-level {
        debug,
        info,
        warn,
        error,
    }
}

/// Shared types across all plugin worlds.
///
/// Types live here (not inside a world) so multiple worlds
/// (mother-child, command, task, etc.) can import and reuse them.
interface types {
    /// Health status enumeration
    enum health-status {
        healthy,
        degraded,
        unhealthy,
    }

    /// Plugin health status with optional reason string.
    record child-health {
        status: health-status,
        reason: option<string>,
    }

    /// Work request from child to Mother (or task to host).
    ///
    /// The plugin decides *what* to run. Host handles *how*.
    /// Plugins never spawn processes directly — they return toys
    /// and the host spawns and monitors them.
    record toy {
        name: string,
        command: string,
        args: list<string>,
    }
}

/// Read-only access to project layer data.
///
/// Task and command plugins use this to read project state
/// without direct filesystem access. Host implements these by
/// calling into the Patina core library.
///
/// Re-entrancy invariant: implementations MUST NOT acquire the
/// store Mutex or call WASM methods on the same instance.
interface layer {
    /// Find the project root directory (walks up from cwd looking for .patina/).
    find-project-root: func() -> option<string>;

    /// Read project config as JSON string.
    read-config: func() -> result<string, string>;

    /// Detect current environment as JSON string.
    detect-environment: func() -> result<string, string>;

    /// Get stored environment tools from project config.
    get-stored-tools: func() -> list<string>;

    /// Count markdown files in a layer subdirectory (e.g., "core", "sessions").
    count-layer-files: func(subdir: string) -> u32;

    /// Get project UID.
    get-project-uid: func() -> option<string>;

    /// Check adapter for updates. Returns current version string or error.
    check-adapter-version: func(adapter-name: string) -> result<option<string>, string>;
}

/// Capability-gated access to Patina's query engines.
///
/// Task and command plugins use this to call scry (semantic search),
/// context (project patterns/beliefs), or assay (structural queries)
/// from inside WASM. The host checks the plugin's granted query kinds
/// at both load time and call time (defense in depth).
interface query {
    /// Execute a query against a Patina engine.
    ///
    /// `kind` — one of "scry", "context", "assay".
    /// `params` — JSON object with kind-specific parameters.
    /// Returns the query result as a string, or an error message.
    query: func(kind: string, params: string) -> result<string, string>;
}

/// Domain-allowlisted HTTP for plugins.
///
/// The host controls TLS, domain enforcement, and credential injection.
/// Plugins never make raw network calls — they call these functions
/// and the host enforces the allowlist from the plugin manifest.
interface http {
    record http-response {
        status: u16,
        body: string,
    }

    /// POST to an allowed domain. Host enforces domain allowlist.
    http-post: func(url: string, body: string, content-type: string) -> result<http-response, string>;

    /// GET from an allowed domain.
    http-get: func(url: string) -> result<http-response, string>;
}

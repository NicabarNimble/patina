package patina:child@0.1.0;

interface runtime-types {
    enum health-status {
        healthy,
        degraded,
        unhealthy,
    }

    record child-health {
        status: health-status,
        reason: option<string>,
    }

    enum task-intent-kind {
        fetch-source,
        run-query,
        emit-facts,
        materialize-index,
        verify-belief,
        sync-graph,
        refresh-credential,
        native-job,
    }

    record task-intent {
        kind: task-intent-kind,
        payload-json: string,
        dedupe-key: option<string>,
    }

    record pending-event {
        stream-name: string,
        offset: u64,
        event-type: string,
        payload-json: string,
        occurred-at: string,
    }
}

package patina:host@0.1.0;

interface log {
    log: func(level: log-level, message: string);

    enum log-level {
        debug,
        info,
        warn,
        error,
    }
}

interface types {
    enum health-status {
        healthy,
        degraded,
        unhealthy,
    }

    record child-health {
        status: health-status,
        reason: option<string>,
    }

    record toy {
        name: string,
        command: string,
        args: list<string>,
    }
}

interface query {
    query: func(kind: string, params: string) -> result<string, string>;
}

interface http {
    record http-response {
        status: u16,
        body: string,
    }

    http-post: func(url: string, body: string, content-type: string) -> result<http-response, string>;
    http-get: func(url: string) -> result<http-response, string>;
}

interface emit {
    emit-fact: func(schema: string, fact-type: string, data: string) -> result<u64, string>;
}

interface measure {
    record-measurement: func(
        verb: string,
        tool: string,
        mode: string,
        metrics-json: string,
    ) -> result<_, string>;
}

interface state {
    get: func(key: string) -> option<string>;
    put: func(key: string, value-json: string) -> result<_, string>;
    delete: func(key: string) -> result<_, string>;
    list-prefix: func(prefix: string) -> list<string>;
}

interface checkpoint {
    load: func(stream-name: string) -> option<string>;
    save: func(stream-name: string, checkpoint-json: string) -> result<_, string>;
}

interface lake {
    record granted-lake {
        name: string,
        path: string,
    }

    list-granted-lakes: func() -> result<list<granted-lake>, string>;
    load-cursor: func(lake-name: string, source: string, data-type: string) -> option<string>;
    save-cursor: func(
        lake-name: string,
        source: string,
        data-type: string,
        cursor: option<string>,
        written: u64,
        status: string,
        last-error: option<string>,
    ) -> result<_, string>;
    ensure-table: func(lake-name: string, table: string) -> result<_, string>;
    append-json-batch: func(
        lake-name: string,
        table: string,
        source: string,
        rows-json: list<string>,
    ) -> result<u64, string>;
    query-json: func(lake-name: string, sql: string) -> result<string, string>;
}

interface ingress {
    record granted-source {
        name: string,
        endpoint: string,
    }

    list-granted-sources: func() -> list<granted-source>;
    fetch: func(source-name: string) -> result<string, string>;
}

interface connector {
    record repo-binding {
        binding-id: string,
        connection: string,
        owner: string,
        repo: string,
        types: list<string>,
    }

    record sync-result {
        binding-id: string,
        data-type: string,
        cursor: option<string>,
        rows-json: list<string>,
    }

    list-bindings: func() -> result<list<repo-binding>, string>;
    upsert-binding: func(binding: repo-binding) -> result<repo-binding, string>;
    remove-binding: func(binding-id: string) -> result<_, string>;
    sync-binding: func(
        binding-id: string,
        data-type: string,
        since: option<string>,
    ) -> result<sync-result, string>;
}

interface events {
    record pending-event {
        stream-name: string,
        offset: u64,
        event-type: string,
        payload-json: string,
        occurred-at: string,
    }

    pull: func(
        stream-name: string,
        after-offset: option<u64>,
        limit: u32,
    ) -> result<list<pending-event>, string>;
    ack-through: func(stream-name: string, offset: u64) -> result<_, string>;
    list-streams: func() -> list<string>;
}

interface task {
    enum task-intent-kind {
        fetch-source,
        run-query,
        emit-facts,
        materialize-index,
        verify-belief,
        sync-graph,
        refresh-credential,
        native-job,
    }

    record task-intent {
        kind: task-intent-kind,
        payload-json: string,
        dedupe-key: option<string>,
    }

    enqueue: func(intent: task-intent) -> result<string, string>;
}

interface graph {
    query: func(kind: string, params-json: string) -> result<string, string>;
    mutate: func(action: string, payload-json: string) -> result<_, string>;
}

interface belief {
    query: func(kind: string, params-json: string) -> result<string, string>;
    mutate: func(action: string, payload-json: string) -> result<_, string>;
}

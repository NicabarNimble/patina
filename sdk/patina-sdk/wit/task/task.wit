package patina:task@0.1.0;

/// World for on-demand action plugins — analyze AND act, then exit.
///
/// Task plugins bridge command plugins (read-only, no toys) and
/// mother-child plugins (daemon-resident). They run once from the CLI,
/// have full host access (query, layer, HTTP), and return toy intents
/// for the host to execute after run() completes.
///
/// Use cases: PR reviewer, one-shot deploy, security scan with webhook.
world task {
    /// Import host logging
    import patina:host/log@0.1.0;

    /// Import shared types (toy) for export signatures
    import patina:host/types@0.1.0;

    /// Import read-only layer access for project data
    import patina:host/layer@0.1.0;

    /// Import capability-gated query access (scry, context, assay)
    import patina:host/query@0.1.0;

    /// Import domain-allowlisted HTTP access
    import patina:host/http@0.1.0;

    /// Import measurement reporting
    import patina:host/measure@0.1.0;

    /// Import fact emission for data ingestion
    import patina:host/emit@0.1.0;

    /// Bring toy type into world scope for toys() export
    use patina:host/types@0.1.0.{toy};

    /// Initialize plugin (host calls first, before any other export)
    export init: func();

    /// Plugin identity — used for dispatch and logging
    export name: func() -> string;

    /// Plugin description for help text
    export description: func() -> string;

    /// Run the task with CLI arguments.
    /// Returns exit code (0 = success, non-zero = failure).
    export run: func(args: list<string>) -> s32;

    /// Return toy intents for host-side execution.
    /// Host filters through allowed_toy_commands before executing.
    export toys: func() -> list<toy>;
}

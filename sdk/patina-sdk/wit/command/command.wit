package patina:command@0.1.0;

/// World for CLI command plugins — one-shot execution, no daemon required.
///
/// Command plugins add subcommands to the `patina` CLI. They run via
/// PluginEngine directly (no Mother daemon needed). The host loads the
/// plugin, calls run() with CLI args, and uses the exit code.
///
/// Separate from mother-child: command plugins don't have heartbeat,
/// tick, toys, or handle(). They run once and exit.
world command {
    /// Import host logging
    import patina:host/log@0.1.0;

    /// Import read-only layer access for project data
    import patina:host/layer@0.1.0;

    /// Import capability-gated query access (scry, context, assay)
    import patina:host/query@0.1.0;

    /// Import measurement reporting
    import patina:host/measure@0.1.0;

    /// Initialize plugin (host calls first, before run)
    export init: func();

    /// Plugin identity — the subcommand name (e.g., "doctor")
    export name: func() -> string;

    /// Plugin description for help text
    export description: func() -> string;

    /// Run the command with CLI arguments.
    /// Returns exit code (0 = success, non-zero = failure).
    export run: func(args: list<string>) -> s32;
}

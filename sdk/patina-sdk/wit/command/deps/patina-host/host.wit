package patina:host@0.1.0;

/// Structured logging for plugins
interface log {
    /// Log a message at the given level
    log: func(level: log-level, message: string);

    enum log-level {
        debug,
        info,
        warn,
        error,
    }
}

/// Shared types across all plugin worlds.
///
/// Types live here (not inside a world) so multiple worlds
/// (mother-child, command, oracle, etc.) can import and reuse them.
/// Phase 1 defined these inside world mother-child{} — moved here
/// in Phase 2 per spec discovery "Move WIT types outside world block."
interface types {
    /// Health status enumeration
    enum health-status {
        healthy,
        degraded,
        unhealthy,
    }

    /// Plugin health status with optional reason string.
    ///
    /// Phase 1 used a bare enum (no reason). Phase 2 adds the reason
    /// field so diagnostic information passes through the WASM boundary
    /// instead of being hardcoded in the WasmChild adapter.
    record child-health {
        status: health-status,
        reason: option<string>,
    }

    /// Work request from child to Mother.
    ///
    /// The child decides *what* to run. Mother handles *how*.
    /// Children never spawn processes directly — they return toys
    /// from tick() and Mother spawns and monitors them.
    record toy {
        name: string,
        command: string,
        args: list<string>,
    }

}

/// Read-only access to project layer data.
///
/// Command plugins (doctor, etc.) use this to read project state
/// without direct filesystem access. Host implements these by
/// calling into the Patina core library.
///
/// Re-entrancy invariant: implementations MUST NOT acquire the
/// store Mutex or call WASM methods on the same instance.
interface layer {
    /// Find the project root directory (walks up from cwd looking for .patina/).
    find-project-root: func() -> option<string>;

    /// Read project config as JSON string.
    read-config: func() -> result<string, string>;

    /// Detect current environment as JSON string.
    detect-environment: func() -> result<string, string>;

    /// Get stored environment tools from project config.
    get-stored-tools: func() -> list<string>;

    /// Count markdown files in a layer subdirectory (e.g., "core", "sessions").
    count-layer-files: func(subdir: string) -> u32;

    /// Get project UID.
    get-project-uid: func() -> option<string>;

    /// Check adapter for updates. Returns current version string or error.
    check-adapter-version: func(adapter-name: string) -> result<option<string>, string>;
}

/// Capability-gated access to Patina's query engines.
///
/// Command plugins use this to call scry (semantic search), context
/// (project patterns/beliefs), or assay (structural queries) from
/// inside WASM. The host checks the plugin's granted query kinds
/// at both load time (manifest validation) and call time (defense
/// in depth). Params and results are JSON strings — typed enums
/// live in the guest API crate, not at the WIT boundary.
interface query {
    /// Execute a query against a Patina engine.
    ///
    /// `kind` — one of "scry", "context", "assay".
    /// `params` — JSON object with kind-specific parameters.
    /// Returns the query result as a string, or an error message.
    query: func(kind: string, params: string) -> result<string, string>;
}

/// Domain-allowlisted HTTP for plugins.
///
/// The host controls TLS, domain enforcement, and credential injection.
/// Plugins never make raw network calls — they call these functions
/// and the host enforces the allowlist from the plugin manifest.
interface http {
    record http-response {
        status: u16,
        body: string,
    }

    /// POST to an allowed domain. Host enforces domain allowlist.
    http-post: func(url: string, body: string, content-type: string) -> result<http-response, string>;

    /// GET from an allowed domain.
    http-get: func(url: string) -> result<http-response, string>;
}

/// Read-only access to installed fact schemas.
///
/// Plugins and commands use this to discover what fact types are
/// registered and query their metadata (field types, index hints,
/// embedding config). The host reads from .patina/schemas/.
interface schema {
    /// List installed schema names (e.g., ["forge"]).
    list-schemas: func() -> list<string>;

    /// Get schema metadata as JSON string.
    /// Returns the parsed schema.toml content for the named schema.
    get-schema: func(name: string) -> result<string, string>;

    /// Get field types for a specific fact within a schema.
    /// Returns JSON object mapping field names to WIT type strings.
    get-field-types: func(schema-name: string, fact-name: string) -> result<string, string>;
}

/// Fact emission for plugins that ingest external data.
///
/// Plugins call emit-fact() during execution. The host validates the
/// schema and fact-type against installed schemas and the plugin
/// manifest, then writes to events.db with provenance=external.
///
/// Design: host import (not intent). Helland analysis — facts are
/// independently valid, host validates and writes, plugin gets
/// confirmation (sequence number). See plugin-infrastructure DESIGN.md.
interface emit {
    /// Emit a structured fact to the project eventlog.
    ///
    /// schema: schema package name (e.g., "forge")
    /// fact-type: fact within schema (e.g., "issue")
    /// data: JSON payload conforming to schema definition
    ///
    /// Returns event sequence number on success.
    /// Host validates: schema installed, plugin declares it, fact-type exists.
    emit-fact: func(schema: string, fact-type: string, data: string) -> result<u64, string>;
}

/// Measurement reporting for plugins.
///
/// Plugins call record-measurement to report metrics to the host.
/// The host writes measurement events to the eventlog with the
/// plugin's name as source (host overrides — plugins can't
/// impersonate core tools).
///
/// verb: one of the 5 protocol verbs (capture, index, search, believe, evolve)
/// tool: which tool produced this (doctor, grammar-rust, etc.)
/// mode: tool-specific sub-mode (freshness-check, parse-coverage, etc.)
/// metrics-json: JSON object with numeric values only
interface measure {
    record-measurement: func(
        verb: string,
        tool: string,
        mode: string,
        metrics-json: string,
    ) -> result<_, string>;
}

/// Plugin-owned opaque key/value state persisted by Mother.
interface state {
    get: func(key: string) -> option<string>;
    put: func(key: string, value-json: string) -> result<_, string>;
    delete: func(key: string) -> result<_, string>;
    list-prefix: func(prefix: string) -> list<string>;
}

/// Stream checkpoints persisted by Mother.
interface checkpoint {
    load: func(stream-name: string) -> option<string>;
    save: func(stream-name: string, checkpoint-json: string) -> result<_, string>;
}

/// Host-mediated lake and storage operations.
interface lake {
    ensure-lake: func(name: string) -> result<string, string>;
    load-cursor: func(lake: string, source: string, data-type: string) -> option<string>;
    save-cursor: func(
        lake: string,
        source: string,
        data-type: string,
        cursor: option<string>,
        written: u64,
        status: string,
        last-error: option<string>,
    ) -> result<_, string>;
    ensure-table: func(lake: string, table: string) -> result<_, string>;
    append-json-batch: func(
        lake: string,
        table: string,
        source: string,
        rows-json: list<string>,
    ) -> result<u64, string>;
    query-json: func(lake: string, sql: string) -> result<string, string>;
}

/// Mother-managed event streams.
interface events {
    record pending-event {
        stream-name: string,
        offset: u64,
        event-type: string,
        payload-json: string,
        occurred-at: string,
    }

    pull: func(
        stream-name: string,
        after-offset: option<u64>,
        limit: u32,
    ) -> result<list<pending-event>, string>;
    ack-through: func(stream-name: string, offset: u64) -> result<_, string>;
    list-streams: func() -> list<string>;
}

/// Typed task intent submission.
interface task {
    enum task-intent-kind {
        fetch-source,
        run-query,
        emit-facts,
        materialize-index,
        verify-belief,
        sync-graph,
        refresh-credential,
        native-job,
    }

    record task-intent {
        kind: task-intent-kind,
        payload-json: string,
        dedupe-key: option<string>,
    }

    enqueue: func(intent: task-intent) -> result<string, string>;
}

/// Capability-gated graph queries and mutations.
interface graph {
    query: func(kind: string, params-json: string) -> result<string, string>;
    mutate: func(action: string, payload-json: string) -> result<_, string>;
}

/// Capability-gated belief queries and mutations.
interface belief {
    query: func(kind: string, params-json: string) -> result<string, string>;
    mutate: func(action: string, payload-json: string) -> result<_, string>;
}

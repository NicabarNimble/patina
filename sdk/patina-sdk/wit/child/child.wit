package patina:child@0.1.0;

interface runtime-types {
    enum health-status {
        healthy,
        degraded,
        unhealthy,
    }

    record child-health {
        status: health-status,
        reason: option<string>,
    }

    enum task-intent-kind {
        fetch-source,
        run-query,
        emit-facts,
        materialize-index,
        verify-belief,
        sync-graph,
        refresh-credential,
        native-job,
    }

    record task-intent {
        kind: task-intent-kind,
        payload-json: string,
        dedupe-key: option<string>,
    }

    record pending-event {
        stream-name: string,
        offset: u64,
        event-type: string,
        payload-json: string,
        occurred-at: string,
    }
}

world child {
    import wasi:http/outgoing-handler@0.2.6;
    import wasi:filesystem/types@0.2.6;
    import wasi:filesystem/preopens@0.2.6;
    import wasi:logging/logging@0.1.0;
    import wasi:keyvalue/store@0.2.0;
    import patina:connect/connect@0.2.0;
    import wasi:sql/readwrite@0.1.0;
    import wasi:messaging/producer@0.2.0;
    import patina:events-stream/events-stream@0.1.0;
    import patina:measure/measure@0.1.0;
    import patina:task/task@0.1.0;
    import patina:peer/peer@0.1.0;
    import patina:git/git@0.1.0;
    import runtime-types;

    use runtime-types.{child-health};
    use runtime-types.{pending-event};
    use runtime-types.{task-intent};

    export init: func();
    export name: func() -> string;
    export on-load: func() -> result<_, string>;
    export on-unload: func();
    export health: func() -> child-health;
    export handle: func(action: string, payload: string) -> result<string, string>;
    export drain: func(limit: u32) -> result<list<pending-event>, string>;
    export tick: func() -> list<task-intent>;
}

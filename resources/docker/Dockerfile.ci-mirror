# CI-mirror Dockerfile for local test parity.
# Mirrors the GitHub Actions ubuntu-latest environment so that
# resources/scripts/test-linux.sh can run the full workspace.
#
# Build:  docker build -f resources/docker/Dockerfile.ci-mirror -t patina-ci-mirror .
# Run:    resources/scripts/test-linux.sh  (auto-detects this image when built)

ARG RUST_VERSION=1.90.0
FROM rust:${RUST_VERSION}-bookworm

# DuckDB native library (matches CI version)
ARG DUCKDB_VERSION=1.1.3
RUN wget -q https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/libduckdb-linux-amd64.zip \
    && unzip -q libduckdb-linux-amd64.zip -d /usr/local/lib/duckdb \
    && rm libduckdb-linux-amd64.zip
ENV DUCKDB_LIB_DIR=/usr/local/lib/duckdb
ENV DUCKDB_INCLUDE_DIR=/usr/local/lib/duckdb
ENV LD_LIBRARY_PATH=/usr/local/lib/duckdb

# WASM target for child integration tests
RUN rustup target add wasm32-wasip2

# System deps for ONNX runtime (ort crate downloads its own binary)
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

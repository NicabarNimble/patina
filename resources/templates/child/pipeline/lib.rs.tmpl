use patina_sdk::pipeline::parse_request;
use patina_sdk::{register_pipeline_child, PipelineChild};

#[derive(Default)]
struct __NAME_STRUCT__;

impl PipelineChild for __NAME_STRUCT__ {
    fn name(&self) -> String {
        "__NAME__".into()
    }

    fn handle(&mut self, request: &str) -> Result<String, String> {
        let req = parse_request(request)?;

        if req.version != "1" {
            return Err(format!("unsupported version: {}", req.version));
        }

        match req.op.as_str() {
            "parse" => Ok(req.payload.to_string()),
            other => Err(format!("unknown op: {}", other)),
        }
    }
}

register_pipeline_child!(__NAME_STRUCT__);

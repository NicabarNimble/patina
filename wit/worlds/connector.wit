package patina:host@0.1.0;

interface connector {
    record repo-binding {
        binding-id: string,
        connection: string,
        owner: string,
        repo: string,
        types: list<string>,
    }

    record sync-result {
        binding-id: string,
        data-type: string,
        cursor: option<string>,
        rows-json: list<string>,
    }

    list-bindings: func() -> result<list<repo-binding>, string>;
    upsert-binding: func(binding: repo-binding) -> result<repo-binding, string>;
    remove-binding: func(binding-id: string) -> result<_, string>;
    sync-binding: func(
        binding-id: string,
        data-type: string,
        since: option<string>,
    ) -> result<sync-result, string>;
}

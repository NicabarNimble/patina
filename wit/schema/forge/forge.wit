package patina:schema/forge@1.0.0;

/// Forge domain — GitHub/Gitea issues and pull requests.
///
/// This schema describes the fact types produced by the forge
/// scraper and grammar-forge pipeline plugin. Types mirror
/// src/forge/types.rs (the hand-written originals).

interface types {
    /// Issue state (platform-agnostic).
    enum issue-state {
        open,
        closed,
    }

    /// Pull request state (platform-agnostic).
    enum pr-state {
        open,
        merged,
        closed,
    }

    /// Comment on an issue or PR.
    record comment {
        author: string,
        body: string,
        created-at: string,
    }

    /// Issue from any forge platform.
    record issue {
        number: s64,
        title: string,
        body: option<string>,
        state: issue-state,
        author: string,
        labels: list<string>,
        created-at: string,
        updated-at: string,
        url: string,
    }

    /// Pull/Merge Request from any forge platform.
    record pull-request {
        number: s64,
        title: string,
        body: option<string>,
        state: pr-state,
        author: string,
        labels: list<string>,
        created-at: string,
        merged-at: option<string>,
        url: string,
        linked-issues: list<s64>,
        comments: list<comment>,
        approvals: s32,
    }
}

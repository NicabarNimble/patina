package patina:pando@0.1.0;

interface source {
    use patina:records/types@0.1.0.{file-found};

    run: func() -> result<list<file-found>, string>;
}

interface extract {
    use patina:records/types@0.1.0.{record-envelope};

    run: func() -> result<list<record-envelope>, string>;
}

interface transform {
    use patina:records/types@0.1.0.{transform-result};

    run: func() -> result<transform-result, string>;
}

interface write {
    use patina:records/types@0.1.0.{file-written};

    run: func() -> result<list<file-written>, string>;
}

interface catalog {
    use patina:records/types@0.1.0.{catalog-entry};

    run: func() -> result<list<catalog-entry>, string>;
}

world catalog-runner {
    import wasi:logging/logging@0.1.0;
    import wasi:keyvalue/store@0.2.0;
    import patina:measure/measure@0.1.0;
    import patina:config/config@0.1.0;
    export catalog;
}

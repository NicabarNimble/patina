-- allium: 3
-- mother-secrets-session-coordination.allium

-- Scope: Mother secrets authority and interface session coordination
-- Includes:
--   - secrets-authority operations (identity, vaults, recipients, env-map)
--   - secrets cache lock/cache/expiry behavior
--   - interface control handshake/resolve/heartbeat/end envelope flows
-- Excludes:
--   - daemon process lifecycle
--   - child warmup/reload and toy orchestration
--   - source/graph routing behavior

entity InterfaceRuntime {
    kind: cli | daemon_http | internal
}

entity SecretsAuthority {
    identity_source: none | environment | encrypted_file | keychain
}

entity SecretVault {
    scope: global | project
    exists: Boolean

    secrets: SecretRecord with vault = this
    recipients: RecipientRecord with vault = this
    registry_bindings: SecretRegistryBinding with vault = this

    secret_count: secrets.count
    recipient_count: recipients.count
}

entity SecretRecord {
    vault: SecretVault
    name: String
    value: String
}

entity SecretRegistryBinding {
    vault: SecretVault
    secret_name: String
    env_var: String
}

entity RecipientRecord {
    vault: SecretVault
    key: String
}

entity SecretsCache {
    cache_state: empty | cached
    expires_at: Timestamp?

    secrets: CachedSecretRecord with cache = this
    cached_secret_count: secrets.count
}

entity CachedSecretRecord {
    cache: SecretsCache
    name: String
    value: String
}

entity InterfaceCoordinator {
    handshakes: InterfaceHandshake with coordinator = this
    envelopes: InterfaceEnvelope with coordinator = this
    sessions: InterfaceSession with coordinator = this
}

entity InterfaceHandshake {
    coordinator: InterfaceCoordinator
    handshake_id: String
    project_uid: String
    project_root: String
    interface_name: String
    launch_intent: attach_or_create | attach_only | create_only
    requested_session: String?
    tmux_mode: String?
    tty: Boolean

    handshake_state: active | expired
    expires_at: Timestamp
}

entity InterfaceSession {
    coordinator: InterfaceCoordinator
    runtime_id: String
    file_id: String
    interface_name: String
    session_state: active | inactive
}

entity InterfaceEnvelope {
    coordinator: InterfaceCoordinator
    envelope_id: String
    project_uid: String
    interface_name: String
    session_runtime_id: String
    session_file_id: String

    tmux_lane: String
    pid: Integer?

    envelope_state: active | ended
    last_heartbeat_at: Timestamp?
    ended_reason: String?
    retention_expires_at: Timestamp?
    updated_at: Timestamp
}

config {
    default_cache_ttl: Duration = 600.seconds
    handshake_ttl: Duration = 120.seconds
    envelope_retention: Duration = 24.hours
}

given {
    authority: SecretsAuthority
    global_vault: SecretVault
    project_vault: SecretVault
    cache: SecretsCache
    coordinator: InterfaceCoordinator
}

rule RejectAddSecretWhenSecretNameIsInvalid {
    when: OperatorAddsSecret(scope, name, value, env_name?)
    requires: not is_valid_secret_name(name)
    ensures: SecretOperationRejected(operation: "add_secret", scope: scope, name: name, reason: "invalid_secret_name")
}

rule RejectAddSecretWhenEnvNameIsInvalid {
    when: OperatorAddsSecret(scope, name, value, env_name?)
    let resolved_env = env_name ?? infer_env_name(name)
    requires: is_valid_secret_name(name)
    requires: not is_valid_env_name(resolved_env)
    ensures: SecretOperationRejected(operation: "add_secret", scope: scope, name: name, reason: "invalid_env_name")
}

rule EnsureIdentityExistsWhenInitializingGlobalVault {
    when: OperatorAddsSecret(scope, name, value, env_name?)
    requires: scope = global
    requires: is_valid_secret_name(name)
    requires: is_valid_env_name(env_name ?? infer_env_name(name))
    requires: not global_vault.exists
    requires: authority.identity_source = none
    ensures: authority.identity_source = encrypted_file
}

rule InitializeGlobalVaultOnFirstSecret {
    when: OperatorAddsSecret(scope, name, value, env_name?)
    requires: scope = global
    requires: is_valid_secret_name(name)
    requires: is_valid_env_name(env_name ?? infer_env_name(name))
    requires: not global_vault.exists
    ensures: global_vault.exists = true
}

rule InitializeProjectVaultOnFirstSecret {
    when: OperatorAddsSecret(scope, name, value, env_name?)
    requires: scope = project
    requires: is_valid_secret_name(name)
    requires: is_valid_env_name(env_name ?? infer_env_name(name))
    requires: not project_vault.exists
    ensures: project_vault.exists = true
}

rule UpsertGlobalSecretValue {
    when: OperatorAddsSecret(scope, name, value, env_name?)
    requires: scope = global
    requires: global_vault.exists
    requires: is_valid_secret_name(name)
    requires: is_valid_env_name(env_name ?? infer_env_name(name))
    ensures:
        if global_vault.secrets.any(secret => secret.name = name):
            for secret in global_vault.secrets where name = name:
                secret.value = value
        else:
            SecretRecord.created(vault: global_vault, name: name, value: value)
}

rule UpsertProjectSecretValue {
    when: OperatorAddsSecret(scope, name, value, env_name?)
    requires: scope = project
    requires: project_vault.exists
    requires: is_valid_secret_name(name)
    requires: is_valid_env_name(env_name ?? infer_env_name(name))
    ensures:
        if project_vault.secrets.any(secret => secret.name = name):
            for secret in project_vault.secrets where name = name:
                secret.value = value
        else:
            SecretRecord.created(vault: project_vault, name: name, value: value)
}

rule UpsertGlobalRegistryBinding {
    when: OperatorAddsSecret(scope, name, value, env_name?)
    let resolved_env = env_name ?? infer_env_name(name)
    requires: scope = global
    requires: global_vault.exists
    requires: is_valid_secret_name(name)
    requires: is_valid_env_name(resolved_env)
    ensures:
        if global_vault.registry_bindings.any(binding => binding.secret_name = name):
            for binding in global_vault.registry_bindings where secret_name = name:
                binding.env_var = resolved_env
        else:
            SecretRegistryBinding.created(vault: global_vault, secret_name: name, env_var: resolved_env)
    ensures: SecretAdded(scope: scope, name: name, env_var: resolved_env)
}

rule UpsertProjectRegistryBinding {
    when: OperatorAddsSecret(scope, name, value, env_name?)
    let resolved_env = env_name ?? infer_env_name(name)
    requires: scope = project
    requires: project_vault.exists
    requires: is_valid_secret_name(name)
    requires: is_valid_env_name(resolved_env)
    ensures:
        if project_vault.registry_bindings.any(binding => binding.secret_name = name):
            for binding in project_vault.registry_bindings where secret_name = name:
                binding.env_var = resolved_env
        else:
            SecretRegistryBinding.created(vault: project_vault, secret_name: name, env_var: resolved_env)
    ensures: SecretAdded(scope: scope, name: name, env_var: resolved_env)
}

rule RejectRemoveSecretWhenVaultMissing {
    when: OperatorRemovesSecret(scope, name)
    requires: (scope = global and not global_vault.exists) or (scope = project and not project_vault.exists)
    ensures: SecretOperationRejected(operation: "remove_secret", scope: scope, name: name, reason: "vault_missing")
}

rule RejectRemoveSecretWhenNotFound {
    when: OperatorRemovesSecret(scope, name)
    requires: (scope = global and global_vault.exists and not global_vault.secrets.any(secret => secret.name = name))
        or (scope = project and project_vault.exists and not project_vault.secrets.any(secret => secret.name = name))
    ensures: SecretOperationRejected(operation: "remove_secret", scope: scope, name: name, reason: "secret_not_found")
}

rule RemoveSecretWhenPresent {
    when: OperatorRemovesSecret(scope, name)
    requires: (scope = global and global_vault.secrets.any(secret => secret.name = name))
        or (scope = project and project_vault.secrets.any(secret => secret.name = name))
    ensures:
        if scope = global:
            for secret in global_vault.secrets where name = name:
                not exists secret
            for binding in global_vault.registry_bindings where secret_name = name:
                not exists binding
        else:
            for secret in project_vault.secrets where name = name:
                not exists secret
            for binding in project_vault.registry_bindings where secret_name = name:
                not exists binding
    ensures: SecretRemoved(scope: scope, name: name)
}

rule ReturnGlobalSecretFromCacheWhenPresent {
    when: OperatorGetsGlobalSecret(name)
    requires: cache.cache_state = cached
    requires: cache.secrets.any(secret => secret.name = name)
    for secret in cache.secrets where name = name:
        ensures: GlobalSecretFound(source: "cache", name: name, value: secret.value)
}

rule ReturnGlobalSecretNotFoundFromCache {
    when: OperatorGetsGlobalSecret(name)
    requires: cache.cache_state = cached
    requires: not cache.secrets.any(secret => secret.name = name)
    ensures: GlobalSecretNotFound(source: "cache", name: name)
}

rule ReturnGlobalSecretFromVaultWhenCacheUnavailable {
    when: OperatorGetsGlobalSecret(name)
    requires: cache.cache_state = empty
    requires: global_vault.exists
    requires: global_vault.secrets.any(secret => secret.name = name)
    for secret in global_vault.secrets where name = name:
        ensures: GlobalSecretFound(source: "global_vault", name: name, value: secret.value)
}

rule ReturnGlobalSecretNotFoundWhenVaultUnavailableOrMissingKey {
    when: OperatorGetsGlobalSecret(name)
    requires: cache.cache_state = empty
    requires: not global_vault.exists or not global_vault.secrets.any(secret => secret.name = name)
    ensures: GlobalSecretNotFound(source: "global_vault", name: name)
}

rule CacheSecretsWithExplicitTtl {
    when: RuntimeCachesSecrets(ttl_secs)
    requires: ttl_secs > 0
    ensures: cache.cache_state = cached
    ensures: cache.expires_at = now + ttl_secs.seconds
    ensures:
        for secret in cache.secrets:
            not exists secret
}

rule CacheSecretsWithDefaultTtl {
    when: RuntimeCachesSecrets(ttl_secs)
    requires: ttl_secs <= 0
    ensures: cache.cache_state = cached
    ensures: cache.expires_at = now + config.default_cache_ttl
    ensures:
        for secret in cache.secrets:
            not exists secret
}

rule AddCachedSecretEntry {
    when: RuntimeCachesSecret(name, value)
    requires: cache.cache_state = cached
    ensures: CachedSecretRecord.created(cache: cache, name: name, value: value)
}

rule ClearCacheOnLock {
    when: RuntimeLocksSecretsCache()
    ensures: cache.cache_state = empty
    ensures: cache.expires_at = null
    ensures:
        for secret in cache.secrets:
            not exists secret
}

rule ExpireCacheAfterTtl {
    when: _: SecretsCache.expires_at <= now
    requires: cache.cache_state = cached
    ensures: cache.cache_state = empty
    ensures: cache.expires_at = null
    ensures:
        for secret in cache.secrets:
            not exists secret
}

rule RejectAddProjectRecipientWhenVaultMissing {
    when: OperatorAddsProjectRecipient(key)
    requires: not project_vault.exists
    ensures: SecretOperationRejected(operation: "add_recipient", scope: project, name: key, reason: "project_vault_missing")
}

rule RejectAddProjectRecipientWhenFormatInvalid {
    when: OperatorAddsProjectRecipient(key)
    requires: project_vault.exists
    requires: not is_valid_age_recipient(key)
    ensures: SecretOperationRejected(operation: "add_recipient", scope: project, name: key, reason: "invalid_recipient")
}

rule RejectAddProjectRecipientWhenAlreadyPresent {
    when: OperatorAddsProjectRecipient(key)
    requires: project_vault.exists
    requires: is_valid_age_recipient(key)
    requires: project_vault.recipients.any(recipient => recipient.key = key)
    ensures: SecretOperationRejected(operation: "add_recipient", scope: project, name: key, reason: "recipient_exists")
}

rule AddProjectRecipient {
    when: OperatorAddsProjectRecipient(key)
    requires: project_vault.exists
    requires: is_valid_age_recipient(key)
    requires: not project_vault.recipients.any(recipient => recipient.key = key)
    ensures: RecipientRecord.created(vault: project_vault, key: key)
    ensures: ProjectVaultReencrypted
}

rule RejectRemoveProjectRecipientWhenVaultMissing {
    when: OperatorRemovesProjectRecipient(key)
    requires: not project_vault.exists
    ensures: SecretOperationRejected(operation: "remove_recipient", scope: project, name: key, reason: "project_vault_missing")
}

rule RejectRemoveProjectRecipientWhenNotFound {
    when: OperatorRemovesProjectRecipient(key)
    requires: project_vault.exists
    requires: not project_vault.recipients.any(recipient => recipient.key = key)
    ensures: SecretOperationRejected(operation: "remove_recipient", scope: project, name: key, reason: "recipient_not_found")
}

rule RejectRemoveLastProjectRecipient {
    when: OperatorRemovesProjectRecipient(key)
    requires: project_vault.exists
    requires: project_vault.recipients.any(recipient => recipient.key = key)
    requires: project_vault.recipient_count <= 1
    ensures: SecretOperationRejected(operation: "remove_recipient", scope: project, name: key, reason: "cannot_remove_last_recipient")
}

rule RemoveProjectRecipient {
    when: OperatorRemovesProjectRecipient(key)
    requires: project_vault.exists
    requires: project_vault.recipients.any(recipient => recipient.key = key)
    requires: project_vault.recipient_count > 1
    ensures:
        for recipient in project_vault.recipients where key = key:
            not exists recipient
    ensures: ProjectVaultReencrypted
}

rule ListProjectRecipients {
    when: OperatorListsProjectRecipients()
    requires: project_vault.exists
    ensures:
        for recipient in project_vault.recipients:
            ProjectRecipientListed(key: recipient.key)
}

rule ReportSecretsStatus {
    when: OperatorRequestsSecretsStatus()
    ensures: SecretsStatusReported(
        identity_source: authority.identity_source,
        global_exists: global_vault.exists,
        global_secret_count: global_vault.secret_count,
        global_recipient_count: global_vault.recipient_count,
        project_exists: project_vault.exists,
        project_secret_count: project_vault.secret_count,
        project_recipient_count: project_vault.recipient_count
    )
}

rule LockSecretsSession {
    when: OperatorLocksSecretsSession()
    ensures: RuntimeLocksSecretsCache()
    ensures: SecretsSessionLocked
}

rule RejectExportIdentityWhenMissing {
    when: OperatorExportsIdentity()
    requires: authority.identity_source = none
    ensures: SecretOperationRejected(operation: "export_identity", scope: global, name: "identity", reason: "identity_missing")
}

rule ExportIdentityWhenPresent {
    when: OperatorExportsIdentity()
    requires: authority.identity_source != none
    ensures: IdentityExported
}

rule RejectImportIdentityWhenFormatInvalid {
    when: OperatorImportsIdentity(identity)
    requires: not is_valid_age_identity(identity)
    ensures: SecretOperationRejected(operation: "import_identity", scope: global, name: "identity", reason: "invalid_identity")
}

rule ImportIdentityWhenValid {
    when: OperatorImportsIdentity(identity)
    requires: is_valid_age_identity(identity)
    ensures: authority.identity_source = encrypted_file
    ensures: IdentityImported
}

rule ResetIdentity {
    when: OperatorResetsIdentity()
    ensures: authority.identity_source = none
    ensures: IdentityReset
}

rule SetupClaudeToken {
    when: OperatorSetsUpClaudeToken(token)
    ensures: OperatorAddsSecret(global, "claude-oauth", token, "CLAUDE_CODE_OAUTH_TOKEN")
    ensures: ClaudeTokenSetupReported
}

rule ResolveEnvMapFromGlobalVault {
    when: OperatorLoadsSecretsEnvMap()
    for binding in global_vault.registry_bindings:
        for secret in global_vault.secrets where name = binding.secret_name:
            ensures: SecretsEnvResolved(scope: global, secret_name: binding.secret_name, env_var: binding.env_var, value: secret.value)
}

rule ResolveEnvMapFromProjectVault {
    when: OperatorLoadsSecretsEnvMap()
    for binding in project_vault.registry_bindings:
        for secret in project_vault.secrets where name = binding.secret_name:
            ensures: SecretsEnvResolved(scope: project, secret_name: binding.secret_name, env_var: binding.env_var, value: secret.value)
}

rule RejectHandshakeWhenRequiredFieldsMissing {
    when: InterfaceHandshakeRequested(protocol_version, cli_version, project_uid, project_root, interface_name, launch_intent, requested_session?, tmux_mode?, tty)
    requires: protocol_version = "" or cli_version = "" or project_uid = "" or project_root = "" or interface_name = ""
    ensures: InterfaceHandshakeRejected(reason: "missing_required_fields")
}

rule RejectHandshakeWhenProjectUidMismatchesProjectRoot {
    when: InterfaceHandshakeRequested(protocol_version, cli_version, project_uid, project_root, interface_name, launch_intent, requested_session?, tmux_mode?, tty)
    requires: protocol_version != ""
    requires: cli_version != ""
    requires: interface_name != ""
    requires: normalize_project_uid(project_root) != project_uid
    ensures: InterfaceHandshakeRejected(reason: "project_uid_mismatch")
}

rule AcceptHandshake {
    when: InterfaceHandshakeRequested(protocol_version, cli_version, project_uid, project_root, interface_name, launch_intent, requested_session?, tmux_mode?, tty)
    requires: protocol_version != ""
    requires: cli_version != ""
    requires: interface_name != ""
    requires: normalize_project_uid(project_root) = project_uid
    ensures: InterfaceHandshake.created(
        coordinator: coordinator,
        handshake_id: generate_id(),
        project_uid: project_uid,
        project_root: project_root,
        interface_name: interface_name,
        launch_intent: launch_intent,
        requested_session: requested_session,
        tmux_mode: tmux_mode,
        tty: tty,
        handshake_state: active,
        expires_at: now + config.handshake_ttl
    )
}

rule ExpireHandshakeAfterTtl {
    when: handshake: InterfaceHandshake.expires_at <= now
    requires: handshake.handshake_state = active
    ensures: handshake.handshake_state = expired
}

rule RejectResolveWhenHandshakeUnknownOrExpired {
    when: InterfaceResolveRequested(requested_handshake_id, title?)
    requires: not coordinator.handshakes.any(h => h.handshake_id = requested_handshake_id and h.handshake_state = active)
    ensures: InterfaceResolveDecisionMade(decision: reject, reason: "unknown_or_expired_handshake")
}

rule RejectResolveWhenRequestedSessionUsedWithCreateOnly {
    when: InterfaceResolveRequested(requested_handshake_id, title?)
    for handshake in coordinator.handshakes where handshake_id = requested_handshake_id and handshake_state = active:
        requires: handshake.requested_session != null
        requires: handshake.launch_intent = create_only
        ensures: InterfaceResolveDecisionMade(decision: reject, reason: "requested_session_with_create_only")
}

rule RejectResolveWhenRequestedSessionMissing {
    when: InterfaceResolveRequested(requested_handshake_id, title?)
    for handshake in coordinator.handshakes where handshake_id = requested_handshake_id and handshake_state = active:
        requires: handshake.requested_session != null
        requires: handshake.launch_intent != create_only
        requires: not coordinator.sessions.any(
            s => s.session_state = active and s.interface_name = handshake.interface_name and (s.runtime_id = handshake.requested_session or s.file_id = handshake.requested_session)
        )
        ensures: InterfaceResolveDecisionMade(decision: reject, reason: "requested_session_not_active")
}

rule AttachRequestedSessionWhenFound {
    when: InterfaceResolveRequested(requested_handshake_id, title?)
    for handshake in coordinator.handshakes where handshake_id = requested_handshake_id and handshake_state = active:
        requires: handshake.requested_session != null
        requires: handshake.launch_intent != create_only
        for session in coordinator.sessions where session_state = active and interface_name = handshake.interface_name and (runtime_id = handshake.requested_session or file_id = handshake.requested_session):
            ensures: SessionAttachChosen(handshake: handshake, session: session)
}

rule RejectAttachOnlyWhenNoActiveSession {
    when: InterfaceResolveRequested(requested_handshake_id, title?)
    for handshake in coordinator.handshakes where handshake_id = requested_handshake_id and handshake_state = active:
        requires: handshake.requested_session = null
        requires: handshake.launch_intent = attach_only
        requires: (coordinator.sessions where session_state = active and interface_name = handshake.interface_name).count = 0
        ensures: InterfaceResolveDecisionMade(decision: reject, reason: "attach_only_no_active_session")
}

rule CreateSessionForCreateOnly {
    when: InterfaceResolveRequested(requested_handshake_id, title?)
    for handshake in coordinator.handshakes where handshake_id = requested_handshake_id and handshake_state = active:
        requires: handshake.requested_session = null
        requires: handshake.launch_intent = create_only
        ensures: SessionCreateChosen(handshake: handshake, title: title ?? (handshake.interface_name + " session"))
}

rule CreateSessionWhenAttachOrCreateHasNoCandidates {
    when: InterfaceResolveRequested(requested_handshake_id, title?)
    for handshake in coordinator.handshakes where handshake_id = requested_handshake_id and handshake_state = active:
        requires: handshake.requested_session = null
        requires: handshake.launch_intent = attach_or_create
        requires: (coordinator.sessions where session_state = active and interface_name = handshake.interface_name).count = 0
        ensures: SessionCreateChosen(handshake: handshake, title: title ?? (handshake.interface_name + " session"))
}

rule AttachSingleCandidateForAttachOrCreate {
    when: InterfaceResolveRequested(requested_handshake_id, title?)
    for handshake in coordinator.handshakes where handshake_id = requested_handshake_id and handshake_state = active:
        requires: handshake.requested_session = null
        requires: handshake.launch_intent = attach_or_create
        requires: (coordinator.sessions where session_state = active and interface_name = handshake.interface_name).count = 1
        ensures:
            for session in coordinator.sessions where session_state = active and interface_name = handshake.interface_name:
                SessionAttachChosen(handshake: handshake, session: session)
}

rule AttachSingleCandidateForAttachOnly {
    when: InterfaceResolveRequested(requested_handshake_id, title?)
    for handshake in coordinator.handshakes where handshake_id = requested_handshake_id and handshake_state = active:
        requires: handshake.requested_session = null
        requires: handshake.launch_intent = attach_only
        requires: (coordinator.sessions where session_state = active and interface_name = handshake.interface_name).count = 1
        ensures:
            for session in coordinator.sessions where session_state = active and interface_name = handshake.interface_name:
                SessionAttachChosen(handshake: handshake, session: session)
}

rule ChooseAmongMultipleCandidatesForAttachOrCreate {
    when: InterfaceResolveRequested(requested_handshake_id, title?)
    for handshake in coordinator.handshakes where handshake_id = requested_handshake_id and handshake_state = active:
        requires: handshake.requested_session = null
        requires: handshake.launch_intent = attach_or_create
        requires: (coordinator.sessions where session_state = active and interface_name = handshake.interface_name).count > 1
        ensures: InterfaceResolveDecisionMade(
            decision: choose,
            option_count: (coordinator.sessions where session_state = active and interface_name = handshake.interface_name).count
        )
        ensures:
            for session in coordinator.sessions where session_state = active and interface_name = handshake.interface_name:
                SessionChoiceOffered(handshake_id: handshake.handshake_id, session_runtime_id: session.runtime_id, session_file_id: session.file_id)
}

rule ChooseAmongMultipleCandidatesForAttachOnly {
    when: InterfaceResolveRequested(requested_handshake_id, title?)
    for handshake in coordinator.handshakes where handshake_id = requested_handshake_id and handshake_state = active:
        requires: handshake.requested_session = null
        requires: handshake.launch_intent = attach_only
        requires: (coordinator.sessions where session_state = active and interface_name = handshake.interface_name).count > 1
        ensures: InterfaceResolveDecisionMade(
            decision: choose,
            option_count: (coordinator.sessions where session_state = active and interface_name = handshake.interface_name).count
        )
        ensures:
            for session in coordinator.sessions where session_state = active and interface_name = handshake.interface_name:
                SessionChoiceOffered(handshake_id: handshake.handshake_id, session_runtime_id: session.runtime_id, session_file_id: session.file_id)
}

rule CreateSessionAndEnvelopeForResolve {
    when: SessionCreateChosen(handshake, title)
    let runtime_id = generate_id()
    let file_id = generate_file_id()
    let lane = derive_tmux_lane(handshake.project_root, handshake.interface_name, file_id)
    ensures: InterfaceSession.created(
        coordinator: coordinator,
        runtime_id: runtime_id,
        file_id: file_id,
        interface_name: handshake.interface_name,
        session_state: active
    )
    ensures: InterfaceEnvelope.created(
        coordinator: coordinator,
        envelope_id: generate_envelope_id(),
        project_uid: handshake.project_uid,
        interface_name: handshake.interface_name,
        session_runtime_id: runtime_id,
        session_file_id: file_id,
        tmux_lane: lane,
        pid: null,
        envelope_state: active,
        last_heartbeat_at: null,
        ended_reason: null,
        retention_expires_at: null,
        updated_at: now
    )
    ensures: InterfaceResolveDecisionMade(decision: create, title: title, session_runtime_id: runtime_id, session_file_id: file_id)
}

rule ReuseActiveEnvelopeWhenAttaching {
    when: SessionAttachChosen(handshake, session)
    requires: coordinator.envelopes.any(
        envelope => envelope.envelope_state = active and envelope.project_uid = handshake.project_uid and envelope.interface_name = handshake.interface_name and envelope.session_runtime_id = session.runtime_id
    )
    for envelope in coordinator.envelopes where envelope_state = active and project_uid = handshake.project_uid and interface_name = handshake.interface_name and session_runtime_id = session.runtime_id:
        ensures: envelope.updated_at = now
        ensures: InterfaceResolveDecisionMade(decision: attach, envelope_id: envelope.envelope_id, session_runtime_id: session.runtime_id, session_file_id: session.file_id)
}

rule CreateEnvelopeWhenAttachingAndNoneActive {
    when: SessionAttachChosen(handshake, session)
    requires: not coordinator.envelopes.any(
        envelope => envelope.envelope_state = active and envelope.project_uid = handshake.project_uid and envelope.interface_name = handshake.interface_name and envelope.session_runtime_id = session.runtime_id
    )
    let lane = derive_tmux_lane(handshake.project_root, handshake.interface_name, session.file_id)
    ensures: InterfaceEnvelope.created(
        coordinator: coordinator,
        envelope_id: generate_envelope_id(),
        project_uid: handshake.project_uid,
        interface_name: handshake.interface_name,
        session_runtime_id: session.runtime_id,
        session_file_id: session.file_id,
        tmux_lane: lane,
        pid: null,
        envelope_state: active,
        last_heartbeat_at: null,
        ended_reason: null,
        retention_expires_at: null,
        updated_at: now
    )
    ensures: InterfaceResolveDecisionMade(decision: attach, session_runtime_id: session.runtime_id, session_file_id: session.file_id)
}

rule RejectHeartbeatWhenEnvelopeUnknown {
    when: InterfaceEnvelopeHeartbeatRequested(envelope_id, pid, tmux_lane, observed_at)
    requires: not coordinator.envelopes.any(envelope => envelope.envelope_id = envelope_id)
    ensures: InterfaceEnvelopeHeartbeatRejected(envelope_id: envelope_id, reason: "unknown_envelope")
}

rule RejectHeartbeatWhenEnvelopeEnded {
    when: InterfaceEnvelopeHeartbeatRequested(envelope_id, pid, tmux_lane, observed_at)
    requires: coordinator.envelopes.any(envelope => envelope.envelope_id = envelope_id and envelope.envelope_state = ended)
    ensures: InterfaceEnvelopeHeartbeatRejected(envelope_id: envelope_id, reason: "envelope_ended")
}

rule AcknowledgeHeartbeatForActiveEnvelope {
    when: InterfaceEnvelopeHeartbeatRequested(envelope_id, pid, tmux_lane, observed_at)
    for envelope in coordinator.envelopes where envelope_id = envelope_id and envelope_state = active:
        ensures: envelope.pid = pid
        ensures: envelope.tmux_lane = tmux_lane
        ensures: envelope.last_heartbeat_at = observed_at
        ensures: envelope.updated_at = now
        ensures: InterfaceEnvelopeHeartbeatAcknowledged(envelope_id: envelope_id, session_runtime_id: envelope.session_runtime_id, session_file_id: envelope.session_file_id)
}

rule RejectEndWhenEnvelopeUnknown {
    when: InterfaceEnvelopeEndRequested(envelope_id, reason)
    requires: not coordinator.envelopes.any(envelope => envelope.envelope_id = envelope_id)
    ensures: InterfaceEnvelopeEndRejected(envelope_id: envelope_id, reason: "unknown_envelope")
}

rule MarkEnvelopeEnded {
    when: InterfaceEnvelopeEndRequested(envelope_id, reason)
    for envelope in coordinator.envelopes where envelope_id = envelope_id and envelope_state = active:
        ensures: envelope.envelope_state = ended
        ensures: envelope.ended_reason = reason
        ensures: envelope.retention_expires_at = now + config.envelope_retention
        ensures: envelope.updated_at = now
        ensures: InterfaceEnvelopeEndAcknowledged(envelope_id: envelope_id, detail: "ended")
}

rule AcknowledgeEnvelopeAlreadyEnded {
    when: InterfaceEnvelopeEndRequested(envelope_id, reason)
    for envelope in coordinator.envelopes where envelope_id = envelope_id and envelope_state = ended:
        ensures: InterfaceEnvelopeEndAcknowledged(envelope_id: envelope_id, detail: "already_ended")
}

rule PruneEnvelopeAfterRetention {
    when: envelope: InterfaceEnvelope.retention_expires_at <= now
    requires: envelope.envelope_state = ended
    ensures: not exists envelope
}

surface MotherSecretsAuthorityAPI {
    facing runtime: InterfaceRuntime
    context authority: SecretsAuthority

    exposes:
        runtime.kind
        authority.identity_source
        global_vault.scope
        global_vault.exists
        global_vault.secret_count
        global_vault.recipient_count
        project_vault.scope
        project_vault.exists
        project_vault.secret_count
        project_vault.recipient_count

        for secret in global_vault.secrets:
            secret.vault.scope
            secret.name
            secret.value

        for binding in global_vault.registry_bindings:
            binding.vault.scope
            binding.secret_name
            binding.env_var

        for recipient in project_vault.recipients:
            recipient.vault.scope
            recipient.key

    provides:
        OperatorGetsGlobalSecret(name)
        OperatorAddsSecret(scope, name, value, env_name?)
        OperatorRemovesSecret(scope, name)
        OperatorAddsProjectRecipient(key)
        OperatorRemovesProjectRecipient(key)
        OperatorListsProjectRecipients()
        OperatorRequestsSecretsStatus()
        OperatorLocksSecretsSession()
        OperatorExportsIdentity()
        OperatorImportsIdentity(identity)
        OperatorResetsIdentity()
        OperatorSetsUpClaudeToken(token)
        OperatorLoadsSecretsEnvMap()
}

surface MotherSecretsCacheAPI {
    facing runtime: InterfaceRuntime
    context cache: SecretsCache

    exposes:
        runtime.kind
        cache.cache_state
        cache.expires_at
        cache.cached_secret_count

        for secret in cache.secrets:
            secret.cache.cache_state
            secret.name
            secret.value

    provides:
        RuntimeCachesSecrets(ttl_secs)
        RuntimeCachesSecret(name, value)
        RuntimeLocksSecretsCache()
}

surface MotherInterfaceControlAPI {
    facing runtime: InterfaceRuntime
    context coordinator: InterfaceCoordinator

    exposes:
        runtime.kind
        coordinator.handshakes.count
        coordinator.envelopes.count
        coordinator.sessions.count

        for handshake in coordinator.handshakes:
            handshake.coordinator.handshakes.count
            handshake.handshake_id
            handshake.project_uid
            handshake.project_root
            handshake.interface_name
            handshake.launch_intent
            handshake.requested_session
            handshake.tmux_mode
            handshake.tty
            handshake.handshake_state
            handshake.expires_at

        for envelope in coordinator.envelopes:
            envelope.coordinator.envelopes.count
            envelope.envelope_id
            envelope.project_uid
            envelope.interface_name
            envelope.session_runtime_id
            envelope.session_file_id
            envelope.tmux_lane
            envelope.pid
            envelope.envelope_state
            envelope.last_heartbeat_at
            envelope.ended_reason
            envelope.retention_expires_at
            envelope.updated_at

        for session in coordinator.sessions:
            session.coordinator.sessions.count
            session.runtime_id
            session.file_id
            session.interface_name
            session.session_state

    provides:
        InterfaceHandshakeRequested(protocol_version, cli_version, project_uid, project_root, interface_name, launch_intent, requested_session?, tmux_mode?, tty)
        InterfaceResolveRequested(handshake_id, title?)
        InterfaceEnvelopeHeartbeatRequested(envelope_id, pid, tmux_lane, observed_at)
        InterfaceEnvelopeEndRequested(envelope_id, reason)
}

open question "Envelope retention pruning is time-based only. Should Mother also prune envelopes proactively by store capacity (2048) with explicit recency semantics in the public contract?"
open question "`setup_claude_token` currently targets global scope. Should project-scoped Claude tokens be first-class in the authority contract?"
open question "`session.completed` stream currently queries status = 'ended' while runtime session status values are active/completed/archived. Which canonical terminal state should drive stream emission?"

-- allium: 3
-- watcher-github-release-install-proof.allium

-- Slate-local spec for proving watcher children can be released and installed from
-- GitHub like the external Slate child. This is not the future bundle installer.

entity GitHubChildReleaseSource {
    source_id: String
    repo: String
    child_name: String
    tag_prefix: String?
    wasm_asset_name: String?
    manifest_asset_name: String?
    checksums_asset_name: String?
}

entity GitHubChildRelease {
    child_name: String
    version: String
    release_tag: String
    wasm_asset_name: String
    manifest_asset_name: String
    checksums_asset_name: String?
    artifact_sha256: String
    manifest_sha256: String
}

entity ChildInstallProof {
    child_name: String
    version: String
    installed_from_source: String
    approved: Boolean
    installed: Boolean
    smoke_checked: Boolean
}

rule SourceTagPrefixSelectsOneChildReleaseStream {
    when: GitHubChildSourceSynced(source)
    requires: exists source.tag_prefix
    ensures: ReleaseTagsFilteredByPrefix(source_id: source.source_id, prefix: source.tag_prefix)
}

rule ConfiguredAssetsSelectReleaseUnit {
    when: GitHubChildSourceSynced(source)
    requires: exists source.wasm_asset_name
    ensures: ReleaseAssetSelected(source_id: source.source_id, asset_name: source.wasm_asset_name)
    ensures: ManifestAssetSelected(source_id: source.source_id, asset_name: source.manifest_asset_name)
}

rule PerChildReleaseKeepsIndependentInstallState {
    when: GitHubChildReleaseDiscovered(release)
    ensures: ChildRegistryEntryCreated(child_name: release.child_name, version: release.version)
    ensures: ReleaseIntegrityHashRecorded(child_name: release.child_name, artifact_sha256: release.artifact_sha256, manifest_sha256: release.manifest_sha256)
}

rule WatcherInstallProofRequiresSmokeCheck {
    when: ChildInstalledFromRegistry(proof)
    requires: proof.installed
    ensures: proof.approved = true
    ensures: proof.smoke_checked = true
}

surface WatcherGitHubReleaseInstallProof {
    facing _: ChildInstallProof
    context source: GitHubChildReleaseSource
    context release: GitHubChildRelease
    context proof: ChildInstallProof

    exposes:
        source.source_id
        source.repo
        source.child_name
        source.tag_prefix
        source.wasm_asset_name
        source.manifest_asset_name
        source.checksums_asset_name
        release.child_name
        release.version
        release.release_tag
        release.wasm_asset_name
        release.manifest_asset_name
        release.checksums_asset_name
        release.artifact_sha256
        release.manifest_sha256
        proof.child_name
        proof.version
        proof.installed_from_source
        proof.approved
        proof.installed
        proof.smoke_checked

    provides:
        GitHubChildSourceSynced(source)
        GitHubChildReleaseDiscovered(release)
        ChildInstalledFromRegistry(proof)
}

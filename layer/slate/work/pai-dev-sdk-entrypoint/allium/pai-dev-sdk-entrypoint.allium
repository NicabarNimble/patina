-- allium: 3
-- pai-dev-sdk-entrypoint.allium

-- Scope: Slate-local model for splitting Patina developer tooling into a
-- dedicated pai-dev SDK entry point without moving Mother/runtime surfaces.
-- Purpose: define the first pai-dev slice as an additive child diagnostics CLI
-- wrapper around the existing patina-child-diagnostics library.

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum CommandSurface { patina | pai | pai_dev }

enum DevStage { local_dev | component_built | release_candidate }

enum DiagnosticResult { pass | fail }

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity CommandEntrypoint {
    name: String
    surface: CommandSurface
    owns_mother_runtime: Boolean
    owns_child_dev_tooling: Boolean
}

entity ChildCheckCommand {
    entrypoint: CommandEntrypoint
    stage: DevStage
    uses_diagnostics_library: Boolean
    mutates_mother_state: Boolean
    result: DiagnosticResult?
}

entity ChildPackageInput {
    path: String
    has_child_toml: Boolean
    has_wit: Boolean
    has_component_path: Boolean
    has_release_path: Boolean
}

entity DiagnosticFinding {
    command: ChildCheckCommand
    code: String
    message: String
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule PaiDevOwnsSdkDeveloperTooling {
    when: entrypoint: CommandEntrypoint.created
    requires: entrypoint.surface = pai_dev
    ensures: entrypoint.owns_child_dev_tooling = true
}

rule PaiDevDoesNotOwnMotherRuntimeInFirstSlice {
    when: entrypoint: CommandEntrypoint.created
    requires: entrypoint.surface = pai_dev
    ensures: entrypoint.owns_mother_runtime = false
}

rule ChildCheckUsesDiagnosticsLibrary {
    when: command: ChildCheckCommand.created
    requires: command.entrypoint.surface = pai_dev
    ensures: command.uses_diagnostics_library = true
}

rule ChildCheckDoesNotMutateMotherState {
    when: command: ChildCheckCommand.created
    requires: command.entrypoint.surface = pai_dev
    ensures: command.mutates_mother_state = false
}

rule LocalDevRequiresManifestAndWit {
    when: input: ChildPackageInput.created
    requires: not input.has_child_toml or not input.has_wit
    ensures: DiagnosticFinding.created(
        command: ChildCheckCommand,
        code: "PTN-DIAGNOSTIC-LOCAL-DEV",
        message: "local-dev child checks fail closed when child.toml or WIT is missing"
    )
}

rule ComponentBuiltRequiresComponentPath {
    when: input: ChildPackageInput.created
    requires: not input.has_component_path
    ensures: DiagnosticFinding.created(
        command: ChildCheckCommand,
        code: "PTN-DIAGNOSTIC-COMPONENT-BUILT",
        message: "component-built checks require an explicit component artifact path"
    )
}

rule ReleaseCandidateRequiresReleasePath {
    when: input: ChildPackageInput.created
    requires: not input.has_release_path
    ensures: DiagnosticFinding.created(
        command: ChildCheckCommand,
        code: "PTN-DIAGNOSTIC-RELEASE-CANDIDATE",
        message: "release-candidate checks require an explicit release bundle path"
    )
}

-- allium: 3
-- pre-push-scaffold-paths-fix.allium

-- Scope: Slate-local anchor for a no-behavior-change path helper fix.

entity ScaffoldPathConstruction {
    uses_project_path_helper: Boolean
    preserves_generated_layout: Boolean
}

rule ScaffoldUsesProjectPathHelperWithoutLayoutChange {
    when: path: ScaffoldPathConstruction.created
    requires: path.uses_project_path_helper = true
    ensures: path.preserves_generated_layout = true
}

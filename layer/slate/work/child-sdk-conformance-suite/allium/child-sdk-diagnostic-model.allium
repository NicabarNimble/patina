-- allium: 3
-- child-sdk-diagnostic-model.allium

-- Scope: Slate-local behavioural model for SDK-side child package diagnostics.
-- Purpose: define how diagnostic findings align child.toml, WIT worlds,
--   built WASM components, and release assets without adding Allium as a
--   public SDK dependency or child-developer requirement.
-- Baseline: WASI Preview 2 / wasm32-wasip2 components with an explicit
--   expansion lane for Preview 3 async, stream, future, and backpressure shapes.
-- Excludes:
--   - implementation crate names or command names
--   - Mother install/approval/runtime orchestration
--   - live execution of third-party child business logic

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ChildPackageLane { push_pure_component | legacy_service | legacy_pipeline }

enum DiagnosticPhase { manifest | wit | component | release }

enum DiagnosticSeverity { error | warning | note }

enum DiagnosticStage { local_dev | component_built | release_candidate }

enum ComponentPreviewLane { preview2 | preview3 | unknown }

enum ToyAuthorityLane { wasi | patina | community | unknown }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity ChildPackage {
    root_path: String
    lane: ChildPackageLane
    diagnostic_stage: DiagnosticStage

    manifest_present: Boolean
    manifest_path: String?

    wit_present: Boolean
    wit_root_path: String?

    component_present: Boolean
    component_path: String?

    release_bundle_present: Boolean
    release_root_path: String?
}

entity ChildManifest {
    package: ChildPackage
    path: String

    name: String?
    version: String?
    kind: String?
    role: String?
    patina_min: String?

    uses_needs_toys: Boolean
    declared_toys: Set<String>
    declared_scopes: Set<String>

    uses_legacy_capabilities: Boolean
    uses_legacy_top_level_toys: Boolean
}

entity WitWorld {
    package: ChildPackage
    path: String

    package_name: String?
    world_name: String?
    preview_lane: ComponentPreviewLane

    resolves: Boolean
    has_imports: Boolean
    has_exports: Boolean
    contains_backend_specific_names: Boolean
}

entity WitToyImport {
    package: ChildPackage
    world: WitWorld

    import_name: String
    toy_name: String
    authority_lane: ToyAuthorityLane
    declared_in_manifest_needs: Boolean
}

entity ComponentArtifact {
    package: ChildPackage
    path: String

    loads_as_component: Boolean
    inspected: Boolean
    world_name: String?
    has_imports: Boolean
    has_exports: Boolean
}

entity ContractArtifactComparison {
    package: ChildPackage
    wit: WitWorld
    component: ComponentArtifact

    world_matches: Boolean
    imports_match: Boolean
    exports_match: Boolean
    toy_needs_match: Boolean
}

entity ReleaseBundle {
    package: ChildPackage
    root_path: String
    tag: String?
    manifest_version: String?

    has_wasm_asset: Boolean
    wasm_matches_component: Boolean
    has_manifest_asset: Boolean
    has_manifest_sha256: Boolean
    has_checksums: Boolean
    checksums_cover_wasm: Boolean
    checksums_cover_manifest: Boolean
    tag_matches_manifest_version: Boolean
}

entity DiagnosticFinding {
    package: ChildPackage
    phase: DiagnosticPhase
    severity: DiagnosticSeverity
    code: String
    location: String?
    message: String
    help: String?
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule PushPurePackageRequiresManifest {
    when: package: ChildPackage.created
    requires: package.lane = push_pure_component
    requires: not package.manifest_present
    ensures: DiagnosticFinding.created(
        package: package,
        phase: manifest,
        severity: error,
        code: "PTN-MANIFEST-001",
        location: package.root_path + "/child.toml",
        message: "push-pure child package is missing child.toml",
        help: "add child.toml with [child] identity and [needs].toys policy declarations"
    )
}

rule PushPurePackageRequiresWitWorld {
    when: package: ChildPackage.created
    requires: package.lane = push_pure_component
    requires: not package.wit_present
    ensures: DiagnosticFinding.created(
        package: package,
        phase: wit,
        severity: error,
        code: "PTN-WIT-001",
        location: package.root_path + "/wit",
        message: "push-pure child package is missing a WIT world",
        help: "add wit/world.wit so the component imports and exports are explicit"
    )
}

rule ManifestRequiresChildName {
    when: manifest: ChildManifest.created
    requires: manifest.name = null
    ensures: DiagnosticFinding.created(
        package: manifest.package,
        phase: manifest,
        severity: error,
        code: "PTN-MANIFEST-002",
        location: manifest.path,
        message: "child.toml is missing child.name",
        help: "set [child].name to the stable package identity used by releases and Mother discovery"
    )
}

rule ManifestRequiresChildVersion {
    when: manifest: ChildManifest.created
    requires: manifest.version = null
    ensures: DiagnosticFinding.created(
        package: manifest.package,
        phase: manifest,
        severity: error,
        code: "PTN-MANIFEST-003",
        location: manifest.path,
        message: "child.toml is missing child.version",
        help: "set [child].version and keep it aligned with release tags and published assets"
    )
}

rule ManifestRequiresChildKind {
    when: manifest: ChildManifest.created
    requires: manifest.kind = null
    ensures: DiagnosticFinding.created(
        package: manifest.package,
        phase: manifest,
        severity: error,
        code: "PTN-MANIFEST-004",
        location: manifest.path,
        message: "child.toml is missing child.kind",
        help: "set [child].kind using child terminology; reserve world terminology for WIT composition"
    )
}

rule ManifestRejectsLegacyCapabilities {
    when: manifest: ChildManifest.created
    requires: manifest.uses_legacy_capabilities
    ensures: DiagnosticFinding.created(
        package: manifest.package,
        phase: manifest,
        severity: error,
        code: "PTN-MANIFEST-005",
        location: manifest.path,
        message: "child.toml uses legacy [capabilities] declarations",
        help: "move authority requests to [needs].toys and optional [needs.scopes]"
    )
}

rule ManifestRejectsLegacyTopLevelToys {
    when: manifest: ChildManifest.created
    requires: manifest.uses_legacy_top_level_toys
    ensures: DiagnosticFinding.created(
        package: manifest.package,
        phase: manifest,
        severity: error,
        code: "PTN-MANIFEST-006",
        location: manifest.path,
        message: "child.toml uses legacy top-level [toys] declarations",
        help: "declare toys under [needs] as toys = [...]"
    )
}

rule ManifestRequiresNeedsToySurface {
    when: manifest: ChildManifest.created
    requires: not manifest.uses_needs_toys
    ensures: DiagnosticFinding.created(
        package: manifest.package,
        phase: manifest,
        severity: error,
        code: "PTN-MANIFEST-007",
        location: manifest.path,
        message: "child.toml does not declare [needs].toys",
        help: "declare [needs].toys, using an empty list only when the component imports no host toy interfaces"
    )
}

rule WitWorldMustResolve {
    when: world: WitWorld.created
    requires: not world.resolves
    ensures: DiagnosticFinding.created(
        package: world.package,
        phase: wit,
        severity: error,
        code: "PTN-WIT-002",
        location: world.path,
        message: "WIT world does not resolve",
        help: "fix package, interface, use, import, and export names until standard WIT tooling can resolve the world"
    )
}

rule WitWorldMustDeclareExports {
    when: world: WitWorld.created
    requires: world.resolves
    requires: not world.has_exports
    ensures: DiagnosticFinding.created(
        package: world.package,
        phase: wit,
        severity: error,
        code: "PTN-WIT-003",
        location: world.path,
        message: "WIT world has no exports",
        help: "export the child business contract that Mother or another component will call"
    )
}

rule WitWorldAvoidsBackendSpecificNames {
    when: world: WitWorld.created
    requires: world.contains_backend_specific_names
    ensures: DiagnosticFinding.created(
        package: world.package,
        phase: wit,
        severity: warning,
        code: "PTN-WIT-004",
        location: world.path,
        message: "WIT world contains orchestration-backend-specific names",
        help: "keep child contracts backend-neutral; place Mother/Rivet/queue-specific adaptation outside child business WIT"
    )
}

rule WitToyImportsMustBeDeclaredInNeeds {
    when: toy_import: WitToyImport.created
    requires: not toy_import.declared_in_manifest_needs
    ensures: DiagnosticFinding.created(
        package: toy_import.package,
        phase: wit,
        severity: error,
        code: "PTN-WIT-005",
        location: toy_import.world.path,
        message: "WIT imports a toy interface that child.toml does not request",
        help: "add the corresponding toy to [needs].toys so host authority requests match component imports"
    )
}

rule UnknownToyAuthorityIsReported {
    when: toy_import: WitToyImport.created
    requires: toy_import.authority_lane = unknown
    ensures: DiagnosticFinding.created(
        package: toy_import.package,
        phase: wit,
        severity: warning,
        code: "PTN-WIT-006",
        location: toy_import.world.path,
        message: "WIT imports an interface that is not known to the toy authority registry",
        help: "use approved WASI or Patina toy interfaces, or document the community/local toy lane explicitly"
    )
}

rule Preview3WorldsUseExpansionLane {
    when: world: WitWorld.created
    requires: world.preview_lane = preview3
    ensures: DiagnosticFinding.created(
        package: world.package,
        phase: wit,
        severity: note,
        code: "PTN-WIT-007",
        location: world.path,
        message: "WIT world uses Preview 3-shaped component features",
        help: "current diagnostics apply the Preview 2 baseline and should expand to async, stream, future, backpressure, and cancellation checks"
    )
}

rule ComponentStageRequiresComponentArtifact {
    when: package: ChildPackage.created
    requires: package.lane = push_pure_component
    requires:
        package.diagnostic_stage = component_built
        or package.diagnostic_stage = release_candidate
    requires: not package.component_present
    ensures: DiagnosticFinding.created(
        package: package,
        phase: component,
        severity: error,
        code: "PTN-COMPONENT-001",
        location: package.root_path,
        message: "component-stage diagnostics require a built WASM component artifact",
        help: "build a wasm32-wasip2 component before running component or release-candidate diagnostics"
    )
}

rule ComponentArtifactMustLoad {
    when: component: ComponentArtifact.created
    requires: not component.loads_as_component
    ensures: DiagnosticFinding.created(
        package: component.package,
        phase: component,
        severity: error,
        code: "PTN-COMPONENT-002",
        location: component.path,
        message: "WASM artifact does not load as a component",
        help: "produce a WebAssembly component, not a raw core module, for push-pure child packages"
    )
}

rule ComponentArtifactMustBeInspectable {
    when: component: ComponentArtifact.created
    requires: component.loads_as_component
    requires: not component.inspected
    ensures: DiagnosticFinding.created(
        package: component.package,
        phase: component,
        severity: error,
        code: "PTN-COMPONENT-003",
        location: component.path,
        message: "WASM component could not be inspected for imports and exports",
        help: "ensure the artifact is valid for component-model introspection tooling"
    )
}

rule ComponentWorldMustMatchWitWorld {
    when: comparison: ContractArtifactComparison.created
    requires: not comparison.world_matches
    ensures: DiagnosticFinding.created(
        package: comparison.package,
        phase: component,
        severity: error,
        code: "PTN-COMPONENT-004",
        location: comparison.component.path,
        message: "built component world does not match the declared WIT world",
        help: "rebuild against the intended WIT world or update the package metadata to the actual target world"
    )
}

rule ComponentImportsMustMatchWit {
    when: comparison: ContractArtifactComparison.created
    requires: not comparison.imports_match
    ensures: DiagnosticFinding.created(
        package: comparison.package,
        phase: component,
        severity: error,
        code: "PTN-COMPONENT-005",
        location: comparison.component.path,
        message: "built component imports differ from the declared WIT imports",
        help: "compare component imports to wit/world.wit and rebuild from the same WIT dependency set"
    )
}

rule ComponentExportsMustMatchWit {
    when: comparison: ContractArtifactComparison.created
    requires: not comparison.exports_match
    ensures: DiagnosticFinding.created(
        package: comparison.package,
        phase: component,
        severity: error,
        code: "PTN-COMPONENT-006",
        location: comparison.component.path,
        message: "built component exports differ from the declared WIT exports",
        help: "compare component exports to wit/world.wit and rebuild from the intended business contract"
    )
}

rule ComponentToyNeedsMustMatchManifest {
    when: comparison: ContractArtifactComparison.created
    requires: not comparison.toy_needs_match
    ensures: DiagnosticFinding.created(
        package: comparison.package,
        phase: component,
        severity: error,
        code: "PTN-COMPONENT-007",
        location: comparison.component.path,
        message: "built component imports do not match child.toml [needs].toys",
        help: "align [needs].toys with the actual component imports reported by component introspection"
    )
}

rule ReleaseCandidateRequiresBundle {
    when: package: ChildPackage.created
    requires: package.lane = push_pure_component
    requires: package.diagnostic_stage = release_candidate
    requires: not package.release_bundle_present
    ensures: DiagnosticFinding.created(
        package: package,
        phase: release,
        severity: error,
        code: "PTN-RELEASE-001",
        location: package.root_path,
        message: "release candidate has no release bundle evidence",
        help: "publish installable release assets before distributing the child"
    )
}

rule ReleaseBundleRequiresWasmAsset {
    when: bundle: ReleaseBundle.created
    requires: not bundle.has_wasm_asset
    ensures: DiagnosticFinding.created(
        package: bundle.package,
        phase: release,
        severity: error,
        code: "PTN-RELEASE-002",
        location: bundle.root_path,
        message: "release bundle is missing the WASM component asset",
        help: "attach the built .wasm component to the release"
    )
}

rule ReleaseBundleRequiresManifestAsset {
    when: bundle: ReleaseBundle.created
    requires: not bundle.has_manifest_asset
    ensures: DiagnosticFinding.created(
        package: bundle.package,
        phase: release,
        severity: error,
        code: "PTN-RELEASE-003",
        location: bundle.root_path,
        message: "release bundle is missing child.toml",
        help: "attach child.toml so registry discovery and install review can read package identity and needs"
    )
}

rule ReleaseBundleRequiresManifestHash {
    when: bundle: ReleaseBundle.created
    requires: bundle.has_manifest_asset
    requires: not bundle.has_manifest_sha256
    ensures: DiagnosticFinding.created(
        package: bundle.package,
        phase: release,
        severity: error,
        code: "PTN-RELEASE-004",
        location: bundle.root_path,
        message: "release bundle is missing child.toml.sha256",
        help: "publish a sidecar hash for child.toml"
    )
}

rule ReleaseBundleRequiresChecksums {
    when: bundle: ReleaseBundle.created
    requires: not bundle.has_checksums
    ensures: DiagnosticFinding.created(
        package: bundle.package,
        phase: release,
        severity: error,
        code: "PTN-RELEASE-005",
        location: bundle.root_path,
        message: "release bundle is missing checksums.txt",
        help: "publish checksums.txt covering the installable WASM and manifest assets"
    )
}

rule ReleaseChecksumsMustCoverWasm {
    when: bundle: ReleaseBundle.created
    requires: bundle.has_checksums
    requires: bundle.has_wasm_asset
    requires: not bundle.checksums_cover_wasm
    ensures: DiagnosticFinding.created(
        package: bundle.package,
        phase: release,
        severity: error,
        code: "PTN-RELEASE-006",
        location: bundle.root_path,
        message: "checksums.txt does not cover the WASM component asset",
        help: "add the WASM asset hash to checksums.txt"
    )
}

rule ReleaseChecksumsMustCoverManifest {
    when: bundle: ReleaseBundle.created
    requires: bundle.has_checksums
    requires: bundle.has_manifest_asset
    requires: not bundle.checksums_cover_manifest
    ensures: DiagnosticFinding.created(
        package: bundle.package,
        phase: release,
        severity: error,
        code: "PTN-RELEASE-007",
        location: bundle.root_path,
        message: "checksums.txt does not cover child.toml",
        help: "add the child.toml hash to checksums.txt"
    )
}

rule ReleaseWasmMustMatchInspectedComponent {
    when: bundle: ReleaseBundle.created
    requires: bundle.has_wasm_asset
    requires: not bundle.wasm_matches_component
    ensures: DiagnosticFinding.created(
        package: bundle.package,
        phase: release,
        severity: error,
        code: "PTN-RELEASE-009",
        location: bundle.root_path,
        message: "release WASM asset does not match the inspected component artifact",
        help: "copy the same component artifact checked by component-built diagnostics into the release bundle before publishing"
    )
}

rule ReleaseTagMustMatchManifestVersion {
    when: bundle: ReleaseBundle.created
    requires: not bundle.tag_matches_manifest_version
    ensures: DiagnosticFinding.created(
        package: bundle.package,
        phase: release,
        severity: error,
        code: "PTN-RELEASE-008",
        location: bundle.root_path,
        message: "release tag does not match child.toml version",
        help: "align the release tag, child.toml version, and package version before publication"
    )
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "What exact diagnostic code namespace should distinguish SDK package diagnostics from Mother install/runtime diagnostics?"
open question "Which Preview 3 checks become baseline once async, stream, future, backpressure, and cancellation support is available in the child tooling stack?"
